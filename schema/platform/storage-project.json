{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StorageProject",
  "description": "One project's retained work, as the Storage screen lists it.",
  "type": "object",
  "properties": {
    "id": {
      "description": "Stable project identifier.",
      "type": "string"
    },
    "name": {
      "description": "Display name.",
      "type": "string"
    },
    "retained_bytes": {
      "description": "Bytes retained under the project's videos.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "video_count": {
      "description": "Queue entries in this project.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "video_count",
    "retained_bytes"
  ]
}
