{
    "name": "av1ation-station",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "npm@11.20.0",
    "engines": {
        "node": ">=26",
        "npm": ">=11"
    },
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "overrides": {
        "dompurify": "3.4.17"
    },
    "scripts": {
        "dev": "node scripts/run-tauri.mjs dev --config rust/desktop-shell/tauri.conf.json",
        "dev:desktop": "npm run dev --workspace @av1ation/desktop",
        "dev:tools": "node scripts/link-dev-tools.mjs",
        "dev:web": "npm run dev --workspace @av1ation/web",
        "dev:website": "npm run dev --workspace @av1ation/website",
        "dev:headless": "node scripts/dev-headless.mjs",
        "tauri": "node scripts/run-tauri.mjs",
        "build": "npm run build --workspaces --if-present",
        "build:ci": "npm run build:website:gallery && npm run build:desktop && npm run build:web",
        "build:desktop": "npm run build --workspace @av1ation/desktop",
        "build:service": "node scripts/build-service.mjs",
        "build:web": "npm run build --workspace @av1ation/web",
        "build:website": "npm run build --workspace @av1ation/website",
        "build:website:gallery": "npm run build:gallery --workspace @av1ation/website",
        "build:demo-tour": "node scripts/build-demo-tour.mjs",
        "check:bundle-size": "node scripts/check-bundle-size.mjs",
        "build:system": "node scripts/build-system.mjs",
        "release:audit": "node scripts/release-audit.mjs",
        "release:build": "node scripts/build-release.mjs",
        "release:manifest": "node scripts/release-manifest.mjs",
        "release:preflight": "node scripts/release-preflight.mjs",
        "release:readiness": "node scripts/release-readiness.mjs",
        "release:weekly-tag": "node scripts/weekly-release-tag.mjs",
        "release:website": "node scripts/website-release.mjs",
        "check:website-release": "node scripts/website-release.mjs --check",
        "toolchain:lock": "node scripts/toolchain-lock.mjs",
        "toolchain:build": "node scripts/toolchain-build.mjs",
        "toolchain:plan": "node scripts/toolchain-build.mjs --all-targets --print-matrix",
        "toolchain:stage": "node scripts/toolchain-build.mjs --assemble-only",
        "toolchain:check": "node scripts/toolchain-verify.mjs --manifest-only",
        "toolchain:verify": "node scripts/toolchain-verify.mjs",
        "clean:outputs": "node scripts/clean-outputs.mjs",
        "clean:target": "node scripts/run-cargo.mjs clean",
        "stage:tools": "node scripts/stage-tools.mjs",
        "typecheck": "node scripts/typecheck.mjs",
        "test": "npm run test:web && npm run test:rust",
        "test:web": "vitest run",
        "test:web:coverage": "node -e \"require('node:fs').mkdirSync('dist/coverage/web', { recursive: true })\" && vitest run --coverage --reporter=default --reporter=json --outputFile.json=dist/coverage/web/vitest.json",
        "test:inventory": "node scripts/test-inventory.mjs",
        "check:test-inventory": "node scripts/check-test-inventory.mjs",
        "mutation:pilot": "node scripts/mutation-pilot.mjs",
        "coverage:check": "node scripts/check-coverage.mjs",
        "coverage:check:web": "node scripts/check-coverage.mjs --frontend --modules",
        "coverage:check:rust": "node scripts/check-coverage.mjs --rust --modules",
        "coverage:check:changed": "node scripts/check-changed-coverage.mjs",
        "coverage:report": "node scripts/coverage-report.mjs",
        "test:rust": "node scripts/run-cargo.mjs test --workspace --locked",
        "test:real-encode": "node scripts/run-real-encode.mjs",
        "audit:dependencies": "node scripts/dependency-audit.mjs",
        "check:disk-space": "node scripts/check-disk-space.mjs",
        "test:rust:coverage": "npm run check:disk-space && node -e \"require('node:fs').mkdirSync('dist/coverage/rust', { recursive: true })\" && node scripts/run-cargo.mjs llvm-cov -p av1ation-engine -p av1ation-service --locked --lcov --output-path ../dist/coverage/rust/rust-lcov.info",
        "test:e2e:build": "node scripts/build-e2e.mjs",
        "test:e2e:run": "playwright test",
        "test:e2e": "npm run test:e2e:build && npm run test:e2e:run",
        "screenshots": "node scripts/generate-screenshots.mjs",
        "build:docs-shots": "node scripts/build-docs-shots.mjs",
        "screenshots:features": "node scripts/generate-screenshots.mjs --feature-notes",
        "check:gallery": "node scripts/check-gallery.mjs",
        "bench:playback": "node scripts/bench-playback.mjs",
        "bench:thumbnails": "node scripts/bench-thumbnails.mjs",
        "format": "npm run format:web && npm run format:rust",
        "format:web": "prettier --write .",
        "format:check": "npm run format:check:web && npm run format:check:rust",
        "format:check:web": "prettier --check .",
        "format:rust": "node scripts/run-cargo.mjs fmt --all",
        "format:check:rust": "node scripts/run-cargo.mjs fmt --all -- --check",
        "lint": "npm run lint:js && npm run lint:rust",
        "lint:js": "eslint .",
        "lint:rust": "node scripts/run-cargo.mjs clippy --workspace --all-targets --locked -- -D warnings",
        "check:evidence": "npm run check:error-evidence && npm run check:route-matrix",
        "check:web": "npm run format:check:web && npm run lint:js && npm run typecheck && npm run check:feature-boundaries && npm run check:api-json && npm run check:evidence && npm run check:docs",
        "check:rust": "npm run format:check:rust && npm run lint:rust && npm run check:service-modules && npm run contracts:check && npm run routes:check && npm run version:check && npm run toolchain:check",
        "check:static": "npm run check:web && npm run check:rust",
        "check": "npm run check:static && npm run test",
        "check:api-json": "node scripts/check-api-json.mjs",
        "check:error-evidence": "node scripts/check-error-evidence.mjs",
        "evidence:generate": "node scripts/check-error-evidence.mjs --write",
        "check:docs": "node scripts/check-docs.mjs",
        "check:route-matrix": "node scripts/route-test-matrix.mjs",
        "routes:matrix": "node scripts/route-test-matrix.mjs --write",
        "verify:web": "npm run test:web:coverage && npm run coverage:check:web && npm run test:inventory && npm run check:test-inventory",
        "verify:rust": "npm run test:rust && npm run test:rust:coverage && npm run coverage:check:rust",
        "verify": "npm run check:static && node scripts/run-verify.mjs",
        "check:feature-boundaries": "node scripts/check-feature-boundaries.mjs",
        "check:service-modules": "node scripts/check-service-modules.mjs",
        "contracts": "npm run contracts:emit && npm run contracts:generate",
        "contracts:emit": "node scripts/run-cargo.mjs run --locked -p av1ation-contracts --bin emit-schema -- --out ../schema --prune",
        "contracts:generate": "node packages/contracts/scripts/generate.mjs",
        "contracts:check": "node scripts/run-cargo.mjs run --locked -p av1ation-contracts --bin emit-schema -- --out ../schema --check && node packages/contracts/scripts/generate.mjs --check",
        "routes": "npm run routes:emit && npm run routes:generate",
        "routes:emit": "node scripts/run-cargo.mjs run --locked -p av1ation-service --bin emit-routes -- --out ../schema/routes/manifest.json",
        "routes:generate": "node scripts/generate-routes.mjs",
        "routes:check": "node scripts/run-cargo.mjs run --locked -p av1ation-service --bin emit-routes -- --out ../schema/routes/manifest.json --check && node scripts/generate-routes.mjs --check && node scripts/check-routes.mjs",
        "doctor": "node scripts/doctor.mjs",
        "version:sync": "node scripts/version.mjs",
        "version:check": "node scripts/version.mjs --check"
    },
    "devDependencies": {
        "@playwright/test": "^1.65.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query": "^5.105.0",
        "@tauri-apps/cli": "^2.12.4",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^24.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "^5.1.0",
        "axe-core": "^4.14.0",
        "dompurify": "3.4.17",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "jsdom": "^30.1.3",
        "json-schema-to-zod": "^2.8.1",
        "playwright-core": "^1.64.1",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwindcss": "^4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "zod": "^4.6.7"
    }
}
