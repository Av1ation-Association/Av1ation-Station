{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://av1ation.local/schema/toolchain.lock.schema.json",
    "title": "Av1ation Station toolchain lock",
    "description": "The generated bytes for every component and target. Do not edit this file by hand.",
    "type": "object",
    "required": ["schema_version", "revision", "manifest_sha256", "targets"],
    "additionalProperties": false,
    "properties": {
        "schema_version": {
            "const": 1
        },
        "revision": {
            "type": "string",
            "minLength": 1
        },
        "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "targets": {
            "type": "object",
            "required": [
                "x86_64-pc-windows-msvc",
                "aarch64-apple-darwin",
                "x86_64-apple-darwin",
                "x86_64-unknown-linux-gnu"
            ],
            "additionalProperties": false,
            "properties": {
                "x86_64-pc-windows-msvc": {
                    "$ref": "#/$defs/target"
                },
                "aarch64-apple-darwin": {
                    "$ref": "#/$defs/target"
                },
                "x86_64-apple-darwin": {
                    "$ref": "#/$defs/target"
                },
                "x86_64-unknown-linux-gnu": {
                    "$ref": "#/$defs/target"
                }
            }
        }
    },
    "$defs": {
        "target": {
            "type": "object",
            "required": ["components"],
            "additionalProperties": false,
            "properties": {
                "components": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                        "$ref": "#/$defs/component"
                    }
                }
            }
        },
        "component": {
            "type": "object",
            "required": ["version", "license", "source", "artifact"],
            "additionalProperties": false,
            "properties": {
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "license": {
                    "type": "string",
                    "minLength": 1
                },
                "source": {
                    "type": "object"
                },
                "artifact": {
                    "type": "object",
                    "required": ["url", "sha256", "size", "install"],
                    "additionalProperties": false,
                    "properties": {
                        "url": {
                            "type": "string",
                            "format": "uri",
                            "pattern": "^https://"
                        },
                        "sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                        },
                        "size": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "install": {
                            "type": "string",
                            "pattern": "^tools/"
                        },
                        "files": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    }
                }
            }
        }
    }
}
