{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://av1ation.local/schema/toolchain.schema.json",
    "title": "Av1ation Station toolchain manifest",
    "description": "The reviewed intent for every bundled component. The generated lock adds the bytes and hashes; this file does not.",
    "type": "object",
    "required": ["schema_version", "revision", "components"],
    "additionalProperties": false,
    "properties": {
        "schema_version": {
            "const": 1
        },
        "revision": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$"
        },
        "components": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/component"
            }
        }
    },
    "$defs": {
        "target": {
            "enum": [
                "x86_64-pc-windows-msvc",
                "aarch64-apple-darwin",
                "x86_64-apple-darwin",
                "x86_64-unknown-linux-gnu"
            ]
        },
        "source": {
            "oneOf": [
                {
                    "type": "object",
                    "required": ["kind", "url", "commit"],
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "git"
                        },
                        "url": {
                            "type": "string",
                            "format": "uri",
                            "pattern": "^https://"
                        },
                        "commit": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{40}$"
                        },
                        "tag": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                {
                    "type": "object",
                    "required": ["kind", "project", "version"],
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "pypi"
                        },
                        "project": {
                            "type": "string",
                            "minLength": 1
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1
                        },
                        "index": {
                            "type": "string",
                            "format": "uri",
                            "pattern": "^https://",
                            "description": "PEP 503 simple index. Omitted means https://pypi.org/simple."
                        }
                    }
                },
                {
                    "type": "object",
                    "required": ["kind", "url", "sha256"],
                    "additionalProperties": false,
                    "properties": {
                        "kind": {
                            "const": "url"
                        },
                        "url": {
                            "type": "string",
                            "format": "uri",
                            "pattern": "^https://"
                        },
                        "sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                        }
                    }
                }
            ]
        },
        "artifact": {
            "type": "object",
            "required": ["install"],
            "additionalProperties": false,
            "properties": {
                "install": {
                    "type": "string",
                    "pattern": "^tools/"
                }
            }
        },
        "component": {
            "type": "object",
            "required": ["id", "version", "license", "provides", "source", "artifacts"],
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z0-9][a-z0-9:+.-]*$"
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "license": {
                    "type": "string",
                    "minLength": 1
                },
                "provides": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "source": {
                    "$ref": "#/$defs/source"
                },
                "build": {
                    "type": "object",
                    "required": ["recipe"],
                    "additionalProperties": false,
                    "properties": {
                        "recipe": {
                            "type": "string",
                            "pattern": "^packaging/recipes/"
                        },
                        "toolchain": {
                            "type": "string",
                            "minLength": 1
                        },
                        "indexes": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "format": "uri",
                                "pattern": "^https://"
                            }
                        },
                        "variables": {
                            "type": "object",
                            "propertyNames": {
                                "pattern": "^[a-z0-9][a-z0-9_:+.-]*$"
                            },
                            "additionalProperties": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    }
                },
                "artifacts": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": false,
                    "propertyNames": {
                        "$ref": "#/$defs/target"
                    },
                    "patternProperties": {
                        "^x86_64-pc-windows-msvc$|^aarch64-apple-darwin$|^x86_64-apple-darwin$|^x86_64-unknown-linux-gnu$": {
                            "$ref": "#/$defs/artifact"
                        }
                    }
                }
            }
        }
    }
}
