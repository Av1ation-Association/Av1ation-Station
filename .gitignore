# ---- Rust ----
**/target
Cargo.lock.bak
*.pdb
*.rlib

# ---- Node ----
node_modules/
.pnp/
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Build output ----
dist/
build/
out/
*.tsbuildinfo
# The language-server archive is built from its pinned lock; never commit it.
rust/crates/service/assets/*.zip

# ---- Tauri ----
rust/desktop-shell/gen/schemas
rust/desktop-shell/tauri.release.generated.json
rust/desktop-shell/tauri.system.conf.json

# ---- Test output ----
test-results/
screenshots/
# The screenshot harness is source, not test output.
!e2e/screenshots/
!e2e/screenshots/catalog.ts
!e2e/screenshots/gallery.spec.ts
# Generated by scripts/build-gallery-media.mjs for the deterministic gallery.
apps/website/public/gallery/
# Generated by scripts/build-demo-tour.mjs from the screenshot gallery.
apps/website/public/demo-tour/
playwright-report/
playwright/.cache/
coverage/
# Source modules may live under a directory named coverage; generated reports stay ignored.
!scripts/coverage/
!scripts/coverage/**
*.lcov
.nyc_output/

# ---- Editors / OS ----
.idea/
# Editor settings are local; shared launch, task, and extension configs stay tracked.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- Local toolchain (optional; kache is not required to build) ----
# The root `.cargo/` is machine-local cache configuration. The workspace file only
# pins the shared build-output location, so it is committed.
.cargo/
!rust/.cargo/
rust/.cargo/*
!rust/.cargo/config.toml
.dev-cache/
# Legacy local toolchain caches; current output lives in dist/dev-tools and dist/cache.
# The suffix also covers a failed swap's staging copy or previous cache.
.dev-tools*

# ---- Local env / secrets ----
.env
.env.*
!.env.example
*.local
*.key
*.pem
*.p12
*.pfx
!buildResources/**/*.p12

# ---- Logs and caches ----
*.log
/logs/
.cache/
.eslintcache
.stylelintcache
.parcel-cache/

# ---- Generated contracts (committed, but never hand-edited) ----
# schema/ and packages/contracts/src/generated/ ARE committed — see docs/contracts.md

# ---- Local design-audit scratch (service data, screenshots, dumped schema) ----
.audit-*
/analytics-*.png
/design/penpot/.check-*.png
/.cfg.json
/.run-start.json
/.dev-data/

# ---- Spikes (deleted once verdicts are recorded) ----
spikes/*/target
spikes/*/node_modules

# ---- Vendor fallback for the engine dependency ----
# vendor/av1an is committed if we reach that fallback — see docs/backend.md §2

# Generated docs captures (run npm run screenshots && npm run build:docs-shots)
apps/website/public/docs-shots/
