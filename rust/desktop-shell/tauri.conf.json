{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Av1ation Station",
    "version": "0.1.0-rc.1",
    "identifier": "com.av1ation.station",
    "build": {
        "beforeDevCommand": "npm run dev --workspace @av1ation/desktop",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build --workspace @av1ation/desktop",
        "frontendDist": "../../dist/apps/desktop"
    },
    "app": {
        "windows": [],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "macOS": {
            "minimumSystemVersion": "15.0"
        },
        "resources": {
            "../../dist/apps/desktop/": "web/"
        },
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
