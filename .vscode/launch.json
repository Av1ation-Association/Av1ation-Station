{
    "version": "0.2.0",
    "compounds": [
        {
            "name": "Debug: Tauri (Rust + Vite)",
            "configurations": ["Debug Rust (Tauri)"],
            "stopAll": true,
            "presentation": { "group": "fullstack", "order": 1 }
        },
        {
            "name": "Debug: Headless Service + Frontend",
            "configurations": ["Debug Service (headless)", "Debug Frontend (Chrome)"],
            "stopAll": true,
            "presentation": { "group": "fullstack", "order": 2 }
        }
    ],
    "configurations": [
        {
            "name": "Debug Rust (Tauri)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--manifest-path", "./rust/desktop-shell/Cargo.toml"],
                "filter": { "name": "av1ation-desktop", "kind": "bin" }
            },
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_BACKTRACE": "1",
                "AV1ATION_LOG": "debug",
                "AV1ATION_TOOLS_DIR": "${workspaceFolder}/dist/dev-tools"
            },
            "preLaunchTask": "vite:dev",
            "presentation": { "group": "fullstack" }
        },
        {
            "name": "Debug Service (headless)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--manifest-path",
                    "./rust/crates/service/Cargo.toml",
                    "--bin",
                    "av1ation-service"
                ],
                "filter": { "name": "av1ation-service", "kind": "bin" }
            },
            "cwd": "${workspaceFolder}",
            "args": ["--port", "8731", "--data-dir", "${workspaceFolder}/dist/test-data/headless"],
            "env": {
                "RUST_BACKTRACE": "1",
                "AV1ATION_LOG": "debug",
                "AV1ATION_TOOLS_DIR": "${workspaceFolder}/dist/dev-tools"
            },
            "preLaunchTask": "vite:dev",
            "presentation": { "group": "fullstack" }
        },
        {
            "name": "Debug Frontend (Chrome)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:1420/?service=http://127.0.0.1:8731",
            "webRoot": "${workspaceFolder}/apps/desktop",
            "sourceMapPathOverrides": {
                "webpack:///./~/*": "${workspaceFolder}/node_modules/*",
                "webpack:///./*": "${workspaceFolder}/apps/desktop/*"
            },
            "skipFiles": ["**/node_modules/**"],
            "presentation": { "group": "fullstack" }
        },
        {
            "name": "Debug Frontend (LAN browser)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:1421",
            "webRoot": "${workspaceFolder}/apps/web",
            "sourceMapPathOverrides": {
                "webpack:///./~/*": "${workspaceFolder}/node_modules/*",
                "webpack:///./*": "${workspaceFolder}/apps/web/*"
            },
            "skipFiles": ["**/node_modules/**"],
            "presentation": { "group": "fullstack" }
        },
        {
            "name": "Attach to Rust (Tauri dev)",
            "type": "lldb",
            "request": "attach",
            "pid": "${command:pickProcess}",
            "presentation": { "group": "fullstack" }
        }
    ]
}
