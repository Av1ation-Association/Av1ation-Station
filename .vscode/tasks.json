{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "vite:dev",
            "type": "npm",
            "script": "dev:desktop",
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*)\\((\\d+),(\\d+)\\): (error|warning) (.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "VITE",
                    "endsPattern": "ready in"
                }
            },
            "presentation": { "group": "dev", "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "service:headless",
            "type": "process",
            "command": "node",
            "args": [
                "scripts/run-cargo.mjs",
                "run",
                "--locked",
                "-p",
                "av1ation-service",
                "--bin",
                "av1ation-service",
                "--",
                "--port",
                "8731",
                "--data-dir",
                "dist/test-data/headless"
            ],
            "options": {
                "env": {
                    "AV1ATION_TOOLS_DIR": "${workspaceFolder}/dist/dev-tools"
                }
            },
            "isBackground": true,
            "problemMatcher": ["$rustc"],
            "presentation": { "group": "dev", "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "dev:headless",
            "type": "npm",
            "script": "dev:headless",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": { "group": "dev", "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "contracts:generate",
            "type": "npm",
            "script": "contracts",
            "problemMatcher": ["$tsc"],
            "presentation": { "group": "build" }
        },
        {
            "label": "test:all",
            "type": "npm",
            "script": "test",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": [],
            "presentation": { "group": "test", "reveal": "always" }
        },
        {
            "label": "test:e2e",
            "type": "npm",
            "script": "test:e2e",
            "problemMatcher": [],
            "presentation": { "group": "test", "reveal": "always" }
        },
        {
            "label": "check",
            "type": "npm",
            "script": "check",
            "problemMatcher": [],
            "presentation": { "group": "build" }
        },
        {
            "label": "lint:all",
            "type": "npm",
            "script": "lint",
            "problemMatcher": ["$eslint-stylish", "$rustc"],
            "presentation": { "group": "build" }
        },
        {
            "label": "doctor",
            "type": "npm",
            "script": "doctor",
            "problemMatcher": [],
            "presentation": { "reveal": "always" }
        }
    ]
}
